# ============================================================
# HUMAN-MAPPING SQUAD — swipe.config
# ============================================================
# Configuração de swipe files para o squad de Human Mapping
# Define fontes, categorias e regras de curadoria de exemplos

swipe:
  categories:
    great-profiles:
      description: "Perfis completos exemplares — multi-camada, com contradições reconciliadas"
      min_layers: 5
      requires_confidence_map: true
      requires_contradiction_audit: true

    great-development-plans:
      description: "Planos de desenvolvimento acionáveis derivados de assessment completo"
      requires_evidence_base: true
      requires_prioritization: true

    contradiction-maps:
      description: "Exemplos de contradições entre frameworks detectadas e reconciliadas"
      requires_resolution: true
      requires_explanation: true

    bad-assessments:
      description: "Anti-exemplos — assessments que falharam e por quê"
      requires_failure_analysis: true
      requires_lesson: true

  sources:
    - gallup-research-index
    - hogan-research-index
    - mbti-research-index
    - enneagram-institute-index
    - via-institute-index
    - belbin-research-index
    - assessment-psychology-journals
    - coaching-organizations-index

  curation_rules:
    - "Todo swipe deve ter data de inclusão e fonte"
    - "Swipes positivos devem passar pelo checklist de qualidade correspondente"
    - "Swipes negativos devem incluir análise de falha explícita"
    - "Atualizar swipes a cada ciclo de ralphloop"
